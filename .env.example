# 复制为 .env；Windows 便携测试由 start-local.bat 单独创建 .env.local。
NODE_ENV=production
APP_ENV_NAME=LOCAL
APP_VERSION=v0.3.0
# 应用仅监听本机；AWS/TENCENT 公网访问须经 HTTPS ALB 或 TLS 反向代理，非回环监听会被拒绝。
BIND_HOST=127.0.0.1
PORT=3030
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=passenger_flow_codex
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=20
# 应用生成、统计使用统一业务时区；DATETIME 原值不会因迁移自动转换。
DB_TIME_ZONE=+08:00
# 云数据库建议开启 TLS，CA 路径按供应商证书填写，不关闭证书校验。
DB_SSL=false
DB_SSL_CA=
# 新源端数据库启动时自动补齐 8 张业务表；腾讯 DTS 目标库必须设为 false，等待 DTS 建表。
AUTO_INIT_SCHEMA=true
# 源端割接停写、目标端迁移期间均设置 true。
MAINTENANCE_MODE=false
DB_READ_ONLY=false
# AWS/TENCENT 或非回环监听必须填写；公网访问必须由 HTTPS 保护。
APP_AUTH_USER=
APP_AUTH_PASSWORD=
GIT_COMMIT=
